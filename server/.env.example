# Local development template. Copy to untracked server/.env and fill private values.

# Secrets and external connections
MONGODB_URI=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Use at least 32 UTF-8 bytes in production. Never commit the value.
AUTH_SECRET=

# Runtime
NODE_ENV=development
PORT=4444
CLIENT_ORIGIN=http://localhost:5173

# AI provider and bounded execution
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
AI_REQUEST_TIMEOUT_MS=8000
QUESTION_CACHE_TTL_MS=60000

# Request and quota limits
AI_REQUESTS_PER_USER_PER_HOUR=20
AI_REQUESTS_PER_IP_PER_HOUR=60
AI_REQUESTS_PER_DAY=200
AUTH_REQUESTS_PER_IP_PER_15_MINUTES=20
UPLOADS_PER_USER_PER_HOUR=10
UPLOADS_PER_IP_PER_HOUR=30
JSON_BODY_LIMIT_BYTES=102400

# Upload storage and size limits
MAX_AUDIO_SIZE_BYTES=5242880
AUDIO_UPLOAD_DIR=server/uploads/audio
MAX_RESUME_SIZE_BYTES=5242880
RESUME_UPLOAD_DIR=server/uploads/resumes
