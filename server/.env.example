# Local development configuration. Fill values only in untracked server/.env.
NODE_ENV=development
PORT=4444
MONGODB_URI=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_REQUEST_TIMEOUT_MS=8000
MAX_RESUME_SIZE_BYTES=5242880
RESUME_UPLOAD_DIR=server/uploads/resumes
OPENAI_API_KEY=
# Use at least 32 UTF-8 bytes in production. Never commit the value.
AUTH_SECRET=
CLIENT_ORIGIN=http://localhost:5173
